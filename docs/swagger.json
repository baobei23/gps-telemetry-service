{
    "swagger": "2.0",
    "info": {
        "description": "HTTP API for ingesting GPS positions using the Traccar OsmAnd query parameter format.",
        "title": "GPS Telemetry Ingestion API",
        "contact": {
            "name": "API Support",
            "url": "https://github.com/baobei23",
            "email": "reginaldsaja98@gmail.com"
        },
        "version": "1.0.0"
    },
    "basePath": "/",
    "paths": {
        "/": {
            "get": {
                "description": "Accepts a GPS position as OsmAnd query parameters. A successful request is acknowledged with an empty 200 response after the position has been persisted. Repeated device ID and timestamp pairs are ignored.",
                "tags": [
                    "Telemetry"
                ],
                "summary": "Ingest a GPS position",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device identifier (up to 32 characters)",
                        "name": "id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "format": "int64",
                        "description": "Device timestamp as Unix epoch seconds",
                        "name": "timestamp",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "description": "Latitude in decimal degrees (-90 to 90)",
                        "name": "lat",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "description": "Longitude in decimal degrees (-180 to 180)",
                        "name": "lon",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Position validity (0 or 1; defaults to 1)",
                        "name": "valid",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Speed in knots (non-negative)",
                        "name": "speed",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Bearing in degrees (0 to 360)",
                        "name": "bearing",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Altitude in metres",
                        "name": "altitude",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Horizontal accuracy in metres (non-negative)",
                        "name": "accuracy",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Horizontal dilution of precision (non-negative)",
                        "name": "hdop",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Battery level (0 to 100)",
                        "name": "batt",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Whether the device is charging",
                        "name": "charge",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Position persisted or duplicate ignored; empty response body"
                    },
                    "400": {
                        "description": "Invalid or missing query parameter",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Unexpected persistence error",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "http.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Something went wrong"
                }
            }
        }
    }
}