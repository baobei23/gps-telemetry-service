{
    "swagger": "2.0",
    "info": {
        "description": "HTTP API for ingesting GPS positions using the Traccar OsmAnd query parameter format.",
        "title": "GPS Telemetry Ingestion API",
        "contact": {
            "name": "API Support",
            "url": "https://github.com/baobei23",
            "email": "reginaldsaja98@gmail.com"
        },
        "version": "1.0.0"
    },
    "basePath": "/",
    "paths": {
        "/": {
            "get": {
                "description": "Accepts a GPS position as OsmAnd query parameters. A successful request is acknowledged with an empty 200 response after the position has been persisted. Repeated device ID and timestamp pairs are ignored.",
                "tags": [
                    "Telemetry"
                ],
                "summary": "Ingest a GPS position",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device identifier (up to 32 characters)",
                        "name": "id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "format": "int64",
                        "description": "Device timestamp as Unix epoch seconds",
                        "name": "timestamp",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "description": "Latitude in decimal degrees (-90 to 90)",
                        "name": "lat",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "description": "Longitude in decimal degrees (-180 to 180)",
                        "name": "lon",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Position validity (0 or 1; defaults to 1)",
                        "name": "valid",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Speed in knots (non-negative)",
                        "name": "speed",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Bearing in degrees (0 to 360)",
                        "name": "bearing",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Altitude in metres",
                        "name": "altitude",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Horizontal accuracy in metres (non-negative)",
                        "name": "accuracy",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Horizontal dilution of precision (non-negative)",
                        "name": "hdop",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Battery level (0 to 100)",
                        "name": "batt",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Whether the device is charging",
                        "name": "charge",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Position persisted or duplicate ignored; empty response body"
                    },
                    "400": {
                        "description": "Invalid or missing query parameter",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Unexpected persistence error",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/devices": {
            "get": {
                "description": "Retrieves all tracked GPS devices with first/last seen timestamps and activity status.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Devices"
                ],
                "summary": "List tracked devices",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/http.BaseResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/telemetry.DeviceSummary"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/devices/{id}/latest": {
            "get": {
                "description": "Retrieves the most recent GPS fix reported by the specified device ID.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Devices"
                ],
                "summary": "Get latest device position",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device identifier",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/http.BaseResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/telemetry.Position"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Device ID is required",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Device not found",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/devices/{id}/positions": {
            "get": {
                "description": "Retrieves paginated GPS position history for a device within an optional time range using keyset cursor pagination.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Devices"
                ],
                "summary": "List position history",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device identifier",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Start timestamp in RFC3339 format",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "End timestamp in RFC3339 format",
                        "name": "to",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Page size limit (1-100, default 50)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Opaque cursor token for next page",
                        "name": "cursor",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/http.PaginatedResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/telemetry.Position"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Invalid query parameter format or range",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Device not found",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "http.BaseResponse": {
            "type": "object",
            "properties": {
                "data": {}
            }
        },
        "http.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Something went wrong"
                }
            }
        },
        "http.PaginatedResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "pagination": {
                    "$ref": "#/definitions/http.PaginationMeta"
                }
            }
        },
        "http.PaginationMeta": {
            "type": "object",
            "properties": {
                "limit": {
                    "type": "integer"
                },
                "nextCursor": {
                    "type": "string"
                }
            }
        },
        "telemetry.DeviceSummary": {
            "type": "object",
            "properties": {
                "firstSeenAt": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "lastSeenAt": {
                    "type": "string"
                },
                "status": {
                    "description": "\"active\" or \"inactive\"",
                    "type": "string"
                }
            }
        },
        "telemetry.Position": {
            "type": "object",
            "properties": {
                "accuracy": {
                    "type": "number"
                },
                "altitude": {
                    "type": "number"
                },
                "batt": {
                    "type": "number"
                },
                "bearing": {
                    "type": "number"
                },
                "charge": {
                    "type": "boolean"
                },
                "deviceId": {
                    "type": "string"
                },
                "deviceTime": {
                    "type": "string"
                },
                "hdop": {
                    "type": "number"
                },
                "id": {
                    "type": "integer"
                },
                "lat": {
                    "type": "number"
                },
                "lon": {
                    "type": "number"
                },
                "serverTime": {
                    "type": "string"
                },
                "speed": {
                    "type": "number"
                },
                "valid": {
                    "type": "integer"
                }
            }
        }
    }
}